# Copy to deploy/.env (gitignored) and fill in real values. Never commit .env.

# Recall's own bearer token. Generate once with: openssl rand -hex 32
RECALL_TOKEN=

# The address the server is reached at, such as https://recall.example.com,
# with no path. It turns on passkey sign-in for /admin, which
# is bound to this address. Leave empty to keep passkey sign-in off.
RECALL_PUBLIC_URL=

# Token for the Cloudflare Tunnel connector, from the Zero Trust dashboard
# (Networks > Tunnels > Create a tunnel > Cloudflared connector). Copy the
# token shown in the install command, not the whole command.
CLOUDFLARE_TUNNEL_TOKEN=

# docker-compose.direct.yml only (its ACME sub-mode): comma-separated
# domains to get a certificate for, and the contact email Let's Encrypt may
# use for expiry notices. DNS for every domain must already point at this
# machine. Leave both empty with the other two compose files.
RECALL_TLS_ACME_DOMAINS=
RECALL_TLS_ACME_EMAIL=
# Let's Encrypt's staging directory instead of production: higher rate
# limits while testing, at the cost of a certificate no real client trusts.
# true/1/yes for staging; empty or false/0/no for production. Anything else
# refuses to start rather than guessing.
RECALL_TLS_ACME_STAGING=

# The merge worker (deploy/README.md, "The merge worker") is off unless its
# profile is named here. Uncomment to start it with the rest of the stack;
# it then waits for you to approve it, and changes nothing until you do.
# COMPOSE_PROFILES=worker
