# Copy to deploy/.env (gitignored) and fill in real values. Never commit .env.

# Recall's own bearer token. Generate once with: openssl rand -hex 32
RECALL_TOKEN=

# Token for the Cloudflare Tunnel connector, from the Zero Trust dashboard
# (Networks > Tunnels > Create a tunnel > Cloudflared connector). Copy the
# token shown in the install command, not the whole command.
CLOUDFLARE_TUNNEL_TOKEN=

# The merge worker (deploy/README.md, "The merge worker") is off unless its
# profile is named here. Uncomment to start it with the rest of the stack;
# it then waits for you to approve it, and changes nothing until you do.
# COMPOSE_PROFILES=worker
