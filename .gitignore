node_modules/
data/
*.db
*.db-journal
# ...except the one database that is a test fixture: written by the Node
# server before it was deleted, and the only remaining evidence of what
# production's rows actually look like. See scripts/compat-check.sh.
!fixtures/node-written.db
deploy/.env

# Rust
/target

# Worktrees. CLAUDE.md asks for feature work to happen in one of these, and
# a worktree is a nested checkout — it must never be committed into the repo
# it is a checkout of.
.claude/worktrees/

# The machine-local half of Claude Code's settings. `.claude/settings.json` is
# committed on purpose — it is what makes a fresh clone and a cloud session
# sync without per-machine setup — but this one is its opposite: it outranks
# the committed file, and it is where a per-machine RECALL_URL or token would
# go. Committing it would push one machine's values onto everyone else's, and
# a token into the history.
.claude/settings.local.json

# A deploy key generated while standing in this directory, which
# docs/reference/github-actions-deploy.md used to invite. That document now
# makes the key in a scratch directory instead, and this is only a backstop —
# a private key that reaches a checkout has already been somewhere it should
# not be, and ignoring it does not undo that.
recall-deploy-key
recall-deploy-key.pub

# Python bytecode from the two checkers in scripts/. Nothing there is
# importable as a module, so this only appears when one is run directly.
__pycache__/
