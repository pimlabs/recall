#!/usr/bin/env node
// Shim: npm creates a bin link at install time, but the real binary is
// fetched by postinstall (install.js) and lands next to this file.
//
// On macOS and Linux this file is normally gone after install: install.js
// moves the verified binary over it, so the bin link runs the binary with
// no Node in between. It is what runs on Windows, and anywhere that move
// failed.
//
// A Node script rather than a POSIX shell script. npm's cmd-shim reads a
// bin file's shebang to decide how to run it on Windows; a `node` shebang
// gets the same reliable .cmd/.ps1 wrapper every other npm CLI package
// gets, always invoked through the Node binary npm itself just ran with.
// The `#!/bin/sh` version this replaced depended on `sh.exe` being on
// PATH, which is Git for Windows' business to provide, not npm's.
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const { spawnSync } = require("node:child_process");

// `npm install -g` on Unix puts a symlink on PATH pointing here, so
// `__filename` is that symlink and looking for the binary next to it would
// search the wrong directory entirely. `realpathSync` resolves it; on
// Windows, where global installs go through cmd-shim rather than a symlink,
// this is a no-op.
const dir = path.dirname(fs.realpathSync(__filename));
const real = path.join(dir, process.platform === "win32" ? "recall-bin.exe" : "recall-bin");

const result = spawnSync(real, process.argv.slice(2), { stdio: "inherit" });

if (result.error) {
  if (result.error.code === "ENOENT") {
    console.error(`recall: binary missing at ${real}; try reinstalling (npm install -g @pimlabs/recall)`);
  } else {
    console.error(`recall: ${result.error.message}`);
  }
  process.exit(1);
}
// A signal killed it rather than an exit code — status is null in that case.
process.exit(result.status === null ? 1 : result.status);
