# Docker reads this from the build context root, which for this image is the
# repository root — see deploy/docker-compose.yml. It lived in server/ for a
# while, where it was never read at all, so `target/` was being uploaded to
# the daemon on every build.
target/
.git/
.claude/worktrees/

data/
*.db
*.db-journal
*.db-wal
*.db-shm

node_modules/
deploy/.env
