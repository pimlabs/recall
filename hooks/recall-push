#!/usr/bin/env bash
# PostToolUse "command" hook. Matcher should be "Edit|Write" (see settings
# snippet). Claude Code has no FileChanged event and no "http" hook type in
# the installed CLI version (confirmed by reading the CLI source, v2.1.42) —
# so this is a "command" hook that filters by path itself and does the HTTP
# call with curl.
#
# Claude Code feeds the hook a JSON payload on stdin:
#   { "hook_event_name": "PostToolUse", "tool_name": "Write"|"Edit",
#     "tool_input": { "file_path": "...", ... }, ... }
# The matcher only matches on tool_name, not path — every Edit/Write call
# reaches this script, including ones that create brand-new topic files
# Claude names on the fly (e.g. debugging.md). That's what makes this catch
# dynamically-created memory files where a literal-filename matcher
# wouldn't.
#
# Deletes don't have a hook of their own — there's no "FileDeleted" event,
# and a delete via the Bash tool (e.g. `rm`) wouldn't match this hook's
# Edit|Write matcher even if there were one. So this script also
# reconciles on every invocation: it compares the current directory
# listing against the last known one (hooks/lib.sh:recall_state_file) and
# reports anything that vanished as a delete, regardless of what actually
# triggered this run. That's what actually catches deletes, not the
# specific FILE_PATH this hook was called with.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"

: "${RECALL_URL:?RECALL_URL must be set (e.g. https://recall.example.com)}"
: "${RECALL_TOKEN:?RECALL_TOKEN must be set}"

INPUT="$(cat)"
FILE_PATH="$(jq -r '.tool_input.file_path // empty' <<<"$INPUT")"
[[ -z "$FILE_PATH" ]] && exit 0

MEM_DIR="$(recall_memory_dir)"
case "$FILE_PATH" in
  "$MEM_DIR"/*) ;;
  *) exit 0 ;;  # not a memory file — nothing to push
esac

PROJECT_KEY="$(recall_project_key)"
SOURCE_ENV="${RECALL_SOURCE_ENV:-$(hostname 2>/dev/null || echo unknown)}"
STATE_FILE="$(recall_state_file)"

push_content() {
  local rel_path="$1" src_file="$2"
  # --rawfile (not --arg "$(cat ...)") because command substitution strips
  # every trailing newline regardless of how many the file actually has —
  # confirmed live: a file with 0 or 2+ trailing newlines came back from a
  # push/pull round-trip with exactly 1, silently changed. --rawfile reads
  # the file's exact bytes into the jq string, trailing newlines included.
  jq -n \
    --arg pk "$PROJECT_KEY" \
    --arg fp "$rel_path" \
    --rawfile c "$src_file" \
    --arg env "$SOURCE_ENV" \
    '{project_key: $pk, file_path: $fp, content: $c, source_env: $env}' |
    curl -sS --fail-with-body -o /dev/null \
      -X POST "$RECALL_URL/sync" \
      -H "Authorization: Bearer $RECALL_TOKEN" \
      -H "Content-Type: application/json" \
      --data-binary @-
}

push_delete() {
  local rel_path="$1"
  jq -n \
    --arg pk "$PROJECT_KEY" \
    --arg fp "$rel_path" \
    --arg env "$SOURCE_ENV" \
    '{project_key: $pk, file_path: $fp, deleted: true, source_env: $env}' |
    curl -sS --fail-with-body -o /dev/null \
      -X POST "$RECALL_URL/sync" \
      -H "Authorization: Bearer $RECALL_TOKEN" \
      -H "Content-Type: application/json" \
      --data-binary @-
}

# Reconcile: anything the state file remembers that's no longer on disk
# was deleted since the last time this ran. Skipped on the very first
# push for a project (no state file yet) so an empty/fresh memory dir
# never gets misread as "everything was deleted".
if [[ -f "$STATE_FILE" ]]; then
  while IFS= read -r rel_path; do
    [[ -n "$rel_path" ]] || continue
    [[ -f "$MEM_DIR/$rel_path" ]] || push_delete "$rel_path"
  done < <(jq -r '.files[]?' "$STATE_FILE" 2>/dev/null)
fi

# The file that actually triggered this hook call, if it still exists.
if [[ -f "$FILE_PATH" ]]; then
  REL_PATH="${FILE_PATH#"$MEM_DIR"/}"
  push_content "$REL_PATH" "$FILE_PATH"
fi

# Refresh the baseline for next time from what's actually on disk now.
mkdir -p "$(dirname "$STATE_FILE")"
find "$MEM_DIR" -type f 2>/dev/null |
  sed "s|^$MEM_DIR/||" |
  sort |
  jq -R -s 'split("\n") | map(select(length > 0)) | {files: .}' \
  > "$STATE_FILE"
